{
  "name": "letsmeet",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:grid": "esbuild src/web/islands/grid.tsx --bundle --minify --format=esm --jsx=automatic --jsx-import-source=react --outfile=public/assets/grid.js",
    "build:createform": "esbuild src/web/islands/createForm.tsx --bundle --minify --format=esm --jsx=automatic --jsx-import-source=react --outfile=public/assets/createForm.js",
    "build:css": "tailwindcss -i src/web/styles/app.css -o public/assets/app.css --minify",
    "build:client": "npm run build:grid && npm run build:createform && npm run build:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@atproto/api": "^0.20.42",
    "@atproto/common": "^0.8.1",
    "@atproto/lexicon": "^0.7.12",
    "@atproto/oauth-client-node": "^0.5.4",
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.5",
    "lucide-react": "^1.39.0",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
